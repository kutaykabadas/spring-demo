<!DOCTYPE HTML>
<html xmlns:th="http://www.thymeleaf.org">

<head>
	<title>Student Registration - Input Form</title>
	<link rel="stylesheet" th:href="@{/css/demo.css}" />
</head>

<body>
	<h3>Student Registration Form</h3>
	<form th:action="@{/processStudentForm}" th:object="${student}" method="POST">
		First Name: <input type:"text" th:field="${student.firstName}" />
		<br /><br />
		Last Name: <input type:"text" th:field="*{lastName}" />
		<br /><br />
		Country:
		<!--<select th:field="${student.country}"name="country">
			<option value="Brazil">Brazil</option>
			<option value="Türkei">Türkei</option>
			<option value="Deutshcland">Deutschland</option>
			<option value="USA">USA</option>
			<option value="Österreich">Österreich</option>
			...
		</select>-->
		<select th:field="${student.country}" name="country">
			<option th:each="tempCountry : ${countries}" th:value="${tempCountry}" th:text="${tempCountry}" />
		</select>
		<br />
		<!--<input type="radio" th:field="${student.favoriteLanguage}" th:value="Java">Java</input>
		<input type="radio" th:field="${student.favoriteLanguage}" th:value="${'C++'}">C++</input>
		<input type="radio" th:field="${student.favoriteLanguage}" th:value="Python">Python</input>-->
		<input type="radio" th:field="${student.favoriteLanguage}" th:each:="tempLanguage : ${languages}"
			th:value="${tempLanguage}" th:text="${tempLanguage}" />
		<br /><br />
		<input type="submit" />
	</form>

</body>

</html>