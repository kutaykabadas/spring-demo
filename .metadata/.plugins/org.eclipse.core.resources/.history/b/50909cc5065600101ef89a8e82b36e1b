<!DOCTYPE HTML>
<html xmlns:th="http://www.thymeleaf.org">

<head>
	<title>Student Confirmation</title>
</head>

<body>
	Student first name: <span th:text="${student.FirstName}" />
	<br />
	Student last name: <span th:text="${student.lastName}" />
	<br />
	Student country: <span th:text="${student.country}" />
	<br />
	Student favorite language: <span th:text="${student.favoriteLanguage}" />
	<br />
	<ul>
		
	<li>>	Student favorite operating system: <span th:text="${student.favoriteOS}"/>
	</ul>
</body>

</html>